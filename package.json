{
  "name": "mezz-ipo-board",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i src/index.css -o app.css --minify",
    "build:js": "esbuild src/main.jsx --bundle --minify --format=iife --jsx=automatic --loader:.css=empty --define:process.env.NODE_ENV=\\\"production\\\" --outfile=app.js",
    "build": "npm run build:css && npm run build:js"
  },
  "dependencies": { "lucide-react": "0.383.0", "react": "18.3.1", "react-dom": "18.3.1" },
  "devDependencies": { "esbuild": "0.23.1", "tailwindcss": "3.4.13" }
}
